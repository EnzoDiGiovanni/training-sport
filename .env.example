# --- Application -------------------------------------------------------------
APP_NAME=Recompo
# local en développement, production sur le VPS (active HTTPS forcé et caches)
APP_ENV=local
# php artisan key:generate
APP_KEY=
# false en production
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Europe/Paris
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Utilisateur unique, créé par `php artisan db:seed` ou `php artisan app:create-user`
APP_OWNER_NAME=Enzo
APP_OWNER_EMAIL=enzo@example.com
APP_OWNER_PASSWORD=

# Reverse proxy (Coolify/Traefik) : adresses de confiance pour X-Forwarded-*
TRUSTED_PROXIES=*

# --- Logs --------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Base de données (MySQL 8 en production ; sqlite possible en local) -----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=recompo
DB_USERNAME=recompo
DB_PASSWORD=

# --- Sessions / cache --------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true en production (cookies uniquement en HTTPS)
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Mail (alertes d'échec de sauvegarde) -----------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="recompo@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sauvegardes (spatie/laravel-backup) -------------------------------------
# Disque(s) de destination, séparés par des virgules. « backups » = S3 si BACKUP_S3_BUCKET est défini,
# sinon storage/app/backups (local, à éviter en production : la sauvegarde doit sortir du VPS).
BACKUP_DISKS=backups
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=fr-par
BACKUP_S3_BUCKET=
# ex. https://s3.fr-par.scw.cloud, https://<compte>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_ROOT=recompo
BACKUP_S3_PATH_STYLE=true
# Chiffre l'archive ZIP (recommandé)
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFY_EMAIL=

VITE_APP_NAME="${APP_NAME}"
